{
  "name": "fenix-dev-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:safe": "node build-script-ultimate.js",
    "build:simple": "copy next.config.simple.js next.config.js && next build",
    "build:fixed": "copy next.config.fixed.js next.config.js && next build",
    "build:minimal": "copy next.config.minimal.js next.config.js && next build",
    "build:ultra-minimal": "copy next.config.ultra-minimal.js next.config.js && next build",
    "build:working": "copy next.config.working.js next.config.js && next build",
    "build:netlify": "copy next.config.netlify.js next.config.js && next build",
    "build:render": "copy next.config.render.js next.config.js && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "npx prisma db push --force-reset && npm run db:seed",
    "db:setup": "node scripts/setup-database.js",
    "db:studio": "npx prisma studio",
    "prod:setup": "node scripts/setup-production.js",
    "prod:deploy": "vercel --prod",
    "prod:logs": "vercel logs --follow",
    "courses:generate": "node scripts/generate-courses.js",
    "courses:run": "node scripts/run-course-generator.js",
    "ide:dev": "next dev --port 3001",
    "clean": "rm -rf .next node_modules package-lock.json",
    "deploy": "npm run clean && npm install && npm run build:vercel && vercel --prod"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.16",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.53.0",
    "multer": "^2.0.2",
    "next": "14.0.4",
    "nodemailer": "^7.0.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.6.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "null-loader": "^4.0.1",
    "postcss": "^8",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.6.2",
    "typescript": "^5"
  }
}
